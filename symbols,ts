.flowchart-container {
  padding: 20px;
  max-width: 1200px;
  margin: 0 auto;
}

.input-section {
  margin-bottom: 20px;
}

textarea {
  width: 100%;
  font-family: monospace;
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 4px;
}

.chart-section {
  border: 1px solid #e0e0e0;
  padding: 10px;
  min-height: 400px;
}

#flowchart-canvas {
  width: 100%;
  height: 400px;
}

/* Style for clickable nodes */
.clickable {
  cursor: pointer;
}

/* Hover effect: Slightly lighten the node's fill */
.clickable:hover rect,
.clickable:hover circle,
.clickable:hover path {
  opacity: 0.8; /* Reduce opacity for a subtle hover effect */
  transition: opacity 0.2s;
}



